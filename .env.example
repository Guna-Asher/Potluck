# --- Deployment RPC endpoints (aliases in foundry.toml [rpc_endpoints]) ---
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/

# --- Contract verification (Monadscan, both networks) ---
MONADSCAN_API_KEY=yourmonadscanapikeyhere

# --- Deployer key ---
# The deploy script takes the key from the forge CLI, never from this file.
# MAINNET: use Foundry's encrypted keystore and deploy with `--account`:
#   cast wallet import potluck-deployer --interactive
#   forge script script/Deploy.s.sol:Deploy --rpc-url monad_mainnet \
#     --account potluck-deployer --sender <deployer address> --broadcast --verify
# TESTNET only, if you must: pass `--private-key 0x...` on the CLI instead.
# Never put a mainnet private key in any .env file.
