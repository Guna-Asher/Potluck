# Monad Mainnet RPC endpoint used by the frontend for all reads/writes.
# The public default below is rate-limited (25 req/s shared) — fine for local
# dev, but for the production deployment use a dedicated provider URL
# (Alchemy/QuickNode/Ankr/dRPC all support Monad mainnet).
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
